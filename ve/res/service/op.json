{
  "get": {
    "instruction": {
      "description": "Read a node's value.",
      "usage": "get [path]",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "description": "node path relative to root; empty = root" }
        },
        "required": []
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "value": { "description": "the node's value (any type)" }
        }
      }
    }
  },

  "set": {
    "instruction": {
      "description": "Write a value to a node, creating it if missing.",
      "usage": "set <path> <value>",
      "input_schema": {
        "type": "object",
        "properties": {
          "path":  { "type": "string", "description": "target node path; created if absent" },
          "value": { "description": "value to write (any type)" }
        },
        "required": ["value"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "description": "path of the written node" }
        }
      }
    }
  },

  "export": {
    "instruction": {
      "description": "Export a subtree as a value tree or native format text.",
      "usage": "export [path] [depth] [format]",
      "input_schema": {
        "type": "object",
        "properties": {
          "path":  { "type": "string", "description": "subtree root; empty = root" },
          "depth": { "type": "integer", "description": "node depth: 0 = own value, 1 = direct children, negative = unlimited" },
          "format": { "type": "string", "description": "omit for tree; json, xml, md, dump or a registered text format for text; other params named like its ExportOptions fields also apply" }
        },
        "required": []
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "tree": { "description": "the exported subtree when format is omitted" },
          "format": { "type": "string", "description": "the requested text format" },
          "text": { "type": "string", "description": "native format output when format is supplied; values are not shortened" }
        }
      }
    }
  },

  "import": {
    "instruction": {
      "description": "Import a value tree into a node.",
      "usage": "import <path> <tree>",
      "input_schema": {
        "type": "object",
        "properties": {
          "path":    { "type": "string", "description": "target path; created if absent" },
          "tree":    { "type": "object", "description": "tree to merge in" },
          "flags":   { "type": "integer", "description": "Node::CopyFlag bitmask: insert=1, remove=2, update=4, replace=8; overrides boolean options (default 9)" },
          "insert":  { "type": "boolean", "description": "add keys missing in the target (default true)" },
          "replace": { "type": "boolean", "description": "overwrite non-null values (default true)" },
          "remove":  { "type": "boolean", "description": "drop keys absent in the tree (default false)" },
          "update":  { "type": "boolean", "description": "write values via update() (default false)" }
        },
        "required": ["path", "tree"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "description": "path of the imported-into node" }
        }
      }
    }
  },

  "meta": {
    "instruction": {
      "description": "Read a node's structure without its value.",
      "usage": "meta [path]",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "description": "node path; empty = root" }
        },
        "required": []
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "type":  { "type": "string", "enum": ["Null", "Bool", "Int", "Double", "String", "Bin", "List", "Dict", "Pointer", "Callable", "Custom"] },
          "count": { "type": "integer", "description": "direct child count" }
        }
      }
    }
  },

  "children": {
    "instruction": {
      "description": "List direct children in insertion order; each entry is its key plus requested get/meta fields.",
      "usage": "children [path] [offset] [limit] [value] [meta]",
      "input_schema": {
        "type": "object",
        "properties": {
          "path":   { "type": "string", "description": "parent path; empty = root" },
          "offset": { "type": "integer", "description": "first child index, default 0; negative counts from the end" },
          "limit":  { "type": "integer", "description": "max entries, default -1 = all remaining" },
          "value":  { "type": "boolean", "description": "add value, as get; default false" },
          "meta":   { "type": "boolean", "description": "add type and count, as meta; default false" }
        },
        "required": []
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "children": {
            "type": "array",
            "description": "entries in range; null when empty",
            "items": {
              "type": "object",
              "properties": {
                "key":   { "type": "string", "description": "name, name#N or #N" },
                "value": { "description": "with value" },
                "type":  { "type": "string", "description": "with meta" },
                "count": { "type": "integer", "description": "with meta" }
              }
            }
          }
        }
      }
    }
  },

  "erase": {
    "instruction": {
      "description": "Erase a node and its subtree.",
      "usage": "erase <path>",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "description": "node path to erase" }
        },
        "required": ["path"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "description": "the erased path" }
        }
      }
    }
  },

  "trigger": {
    "instruction": {
      "description": "Fire NODE_CHANGED on a node without changing its value.",
      "usage": "trigger <path>",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "description": "node path to trigger" }
        },
        "required": ["path"]
      }
    }
  },

  "subscribe": {
    "instruction": {
      "description": "Subscribe to a node's changes (requires a push-capable session).",
      "usage": "subscribe <path> [depth]",
      "input_schema": {
        "type": "object",
        "properties": {
          "path":      { "type": "string",  "description": "node path to watch" },
          "depth":     { "type": "integer", "description": "subtree depth pushed on change, -1 = unlimited" },
          "once":      { "type": "boolean", "description": "auto-unsubscribe after the first change" },
          "immediate": { "type": "boolean", "description": "also return the current value now" }
        },
        "required": ["path"]
      }
    }
  },

  "unsubscribe": {
    "instruction": {
      "description": "Stop watching a node.",
      "usage": "unsubscribe <path>",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "description": "node path to stop watching" }
        },
        "required": ["path"]
      }
    }
  },

  "commands": {
    "instruction": {
      "description": "List registered commands.",
      "usage": "commands",
      "input_schema": { "type": "object", "properties": {}, "required": [] },
      "output_schema": {
        "type": "object",
        "properties": {
          "commands": {
            "type": "array",
            "description": "registered command names + one-line help",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "help": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },

  "describe": {
    "instruction": {
      "description": "Return a command's full description: help, input and output schema.",
      "usage": "describe <name>",
      "input_schema": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "command name to describe" }
        },
        "required": ["name"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "name":          { "type": "string" },
          "description":   { "type": "string" },
          "input_schema":  { "type": "object" },
          "output_schema": { "type": "object" }
        }
      }
    }
  }
}
