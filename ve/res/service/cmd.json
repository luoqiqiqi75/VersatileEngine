{
  "save": {
    "instruction": {
      "description": "Save a subtree to file, creating parent directories as needed. Uses the same serialization formats as schema.",
      "usage": "save [file] [path] [format] | save [--file <file>] [--path <path>] [--format <format>]",
      "input_schema": {
        "type": "object",
        "properties": {
          "file":   { "type": "string", "description": "output file (default: <node name>.<format>; unnamed node: root.<format>); supports ~/; creates parent directories" },
          "path":   { "type": "string", "description": "node path (default: session current node or root; required without session); relative to current node, / starts at root" },
          "format": { "type": "string", "description": "schema format: explicit > file extension > json" }
        },
        "required": []
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "file": { "type": "string", "description": "written file path" },
          "path": { "type": "string", "description": "exported node path relative to session or global root" },
          "format": { "type": "string", "description": "serialization format used" },
          "size": { "type": "integer", "description": "bytes written" }
        }
      }
    }
  },

  "load": {
    "instruction": {
      "description": "Load a file into a subtree, creating missing target nodes. Uses the same defaults and serialization formats as save.",
      "usage": "load [file] [path] [format] | load [--file <file>] [--path <path>] [--format <format>]",
      "input_schema": {
        "type": "object",
        "properties": {
          "file":   { "type": "string", "description": "input file (default: <node name>.<format>; unnamed node: root.<format>); supports ~/" },
          "path":   { "type": "string", "description": "target node path, created if absent (default: session current node or root; required without session); relative to current node, / starts at root" },
          "format": { "type": "string", "description": "schema format: explicit > file extension > json" }
        },
        "required": []
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "file": { "type": "string", "description": "read file path" },
          "path": { "type": "string", "description": "imported node path relative to session or global root" },
          "format": { "type": "string", "description": "serialization format used" },
          "size": { "type": "integer", "description": "bytes read" }
        }
      }
    }
  },

  "search": {
    "instruction": {
      "description": "Locate nodes under root by matching key or value. AI-friendly: default mode is substring 'contains' (case-insensitive). Use mode='glob' for */? wildcards or mode='exact' for strict equality. Returns matching paths, stops after 'top' hits.",
      "usage": "search <pattern> [root] [--mode contains|glob|exact] [--target key|value] [--case_sensitive] [--top N]",
      "input_schema": {
        "type": "object",
        "properties": {
          "pattern":        { "type": "string",  "description": "match string; interpretation depends on mode" },
          "root":           { "type": "string",  "description": "subtree root path; defaults to session root" },
          "mode":           { "type": "string",  "enum": ["contains", "glob", "exact"], "description": "match mode; default 'contains'" },
          "target":         { "type": "string",  "enum": ["key", "value"], "description": "match target; default 'key'" },
          "case_sensitive": { "type": "boolean", "description": "default false" },
          "top":            { "type": "integer", "description": "max matches; default 100" }
        },
        "required": ["pattern"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "matches": { "type": "array", "items": { "type": "string" }, "description": "paths relative to root, DFS insertion order" },
          "count":   { "type": "integer", "description": "matches.size()" }
        }
      }
    }
  },

  "plugin": {
    "load": {
      "instruction": {
        "description": "Load a plugin spec or an anonymous list using the same method as entry plugins.",
        "usage": "plugin load <path> [--enabled true|false] [--name <name>] [--min_api N]",
        "input_schema": {
          "type": ["object", "array"],
          "properties": {
            "path": { "type": "string" },
            "enabled": { "type": "boolean", "default": true },
            "name": { "type": "string", "description": "Default: filename stem without leading lib" },
            "min_api": { "type": "integer", "minimum": 0, "default": 0 }
          },
          "required": ["path"],
          "items": { "type": "object", "required": ["path"] }
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "plugins": { "type": "array", "items": { "type": "object", "properties": {
              "name": { "type": "string" }, "path": { "type": "string" },
              "loaded": { "type": "boolean" }, "skipped": { "type": "boolean" }
            } } },
            "count": { "type": "integer" }
          }
        }
      }
    },
    "unload": {
      "instruction": {
        "description": "Release a plugin library by name, or derive its default name from path. Also accepts an anonymous list.",
        "usage": "plugin unload <name> | plugin unload --path <path>",
        "input_schema": {
          "type": ["object", "array"],
          "properties": {
            "name": { "type": "string" },
            "path": { "type": "string" },
            "enabled": { "type": "boolean", "default": true }
          },
          "items": { "type": "object" }
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "plugins": { "type": "array", "items": { "type": "object", "properties": {
              "name": { "type": "string" }, "path": { "type": "string" },
              "loaded": { "type": "boolean" }, "skipped": { "type": "boolean" }
            } } },
            "count": { "type": "integer" }
          }
        }
      }
    }
  }
}
