{
  "save": {
    "instruction": {
      "description": "Save a subtree to file.",
      "usage": "save <path> <file> [format]",
      "input_schema": {
        "type": "object",
        "properties": {
          "path":   { "type": "string", "description": "subtree root path" },
          "file":   { "type": "string", "description": "output file path" },
          "format": { "type": "string", "description": "json|bin|xml (default: auto from extension)" }
        },
        "required": ["path", "file"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "file": { "type": "string", "description": "written file path" },
          "size": { "type": "integer", "description": "bytes written" }
        }
      }
    }
  },

  "load": {
    "instruction": {
      "description": "Load a file into a subtree.",
      "usage": "load <file> <path> [format]",
      "input_schema": {
        "type": "object",
        "properties": {
          "file":   { "type": "string", "description": "input file path" },
          "path":   { "type": "string", "description": "target node path (created if absent)" },
          "format": { "type": "string", "description": "json|bin|xml (default: auto from extension)" }
        },
        "required": ["file", "path"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "description": "imported node path" }
        }
      }
    }
  },

  "search": {
    "instruction": {
      "description": "Locate nodes under root by matching key or value. AI-friendly: default mode is substring 'contains' (case-insensitive). Use mode='glob' for */? wildcards or mode='exact' for strict equality. Returns matching paths, stops after 'top' hits.",
      "usage": "search <pattern> [root] [--glob|--exact] [--key|--value] [-i|--case-sensitive] [--top N]",
      "input_schema": {
        "type": "object",
        "properties": {
          "pattern":        { "type": "string",  "description": "match string; interpretation depends on mode" },
          "root":           { "type": "string",  "description": "subtree root path; defaults to session root" },
          "mode":           { "type": "string",  "enum": ["contains", "glob", "exact"], "description": "match mode; default 'contains'" },
          "target":         { "type": "string",  "enum": ["key", "value"], "description": "match target; default 'key'" },
          "case_sensitive": { "type": "boolean", "description": "default false" },
          "top":            { "type": "integer", "description": "max matches; default 100" },
          "args":           { "type": "array",   "description": "positional form: [pattern, root?, ...flags]; named fields override" }
        },
        "required": ["pattern"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "matches": { "type": "array", "items": { "type": "string" }, "description": "paths relative to root, DFS insertion order" },
          "count":   { "type": "integer", "description": "matches.size()" }
        }
      }
    }
  }
}
